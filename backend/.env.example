# Copy to backend/.env and fill in.

# Local dev without TiDB:
#   DATABASE_URL=sqlite:///./reegal.db
# TiDB Cloud (MySQL-compatible, TLS is enabled automatically for mysql URLs):
#   DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:4000/<database>
DATABASE_URL=sqlite:///./reegal.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically after repeated 503 "high demand" errors on GEMINI_MODEL. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# true = use Developer 1 stubs (registry, retrieval, applicability, calculators, scoring)
USE_STUBS=true

# prefetch = code gathers the evidence, then one Gemini call per agent (3 per assessment).
# legacy = the original Gemini tool loop plus a report call (8 to 15 per assessment).
AGENT_MODE=prefetch
# One extra investigate + report round for findings with low confidence or no evidence.
ESCALATION_ENABLED=true
