# Copy to backend/.env and fill in.

# Local dev without TiDB:
#   DATABASE_URL=sqlite:///./reegal.db
# TiDB Cloud (copy the Console URI; passwords must be URL-encoded):
#   DATABASE_URL="mysql+pymysql://<instance-prefix>.root:<password>@<host>:4000/<database>?ssl_ca=/etc/ssl/cert.pem&ssl_verify_cert=true&ssl_verify_identity=true"
# The app verifies TiDB TLS itself and supports these Console TLS query parameters.
DATABASE_URL=sqlite:///./reegal.db

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used automatically after repeated 503 "high demand" errors on GEMINI_MODEL. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Confirmed by a live probe for the above model. Changing this requires a new
# VECTOR(D) column/index and re-embedding every stored chunk.
GEMINI_EMBEDDING_DIMENSIONS=3072

# true = use Developer 1 stubs (registry, retrieval, applicability, calculators, scoring)
USE_STUBS=true

# prefetch = code gathers the evidence, then one Gemini call per agent (3 per assessment).
# legacy = the original Gemini tool loop plus a report call (8 to 15 per assessment).
AGENT_MODE=prefetch
# One extra investigate + report round for findings with low confidence or no evidence.
ESCALATION_ENABLED=true
# Staged live-retrieval testing. Keep these false until the research owner has reviewed
# the corpus and mapped chunks to requirements.
USE_TIDB_RETRIEVAL=false
USE_TIDB_SEMANTIC_RETRIEVAL=false
ALLOW_UNREVIEWED_KNOWLEDGE=false
ALLOW_CANDIDATE_REQUIREMENT_MAPPINGS=false
ALLOW_DRAFT_REGISTRY=false
